# Metron API Configuration
# Copy this file to .env and fill in your keys

# LLM API (required for build agent)
OPENROUTER_API_KEY=your-openrouter-key-here
# Or use other providers:
# DEEPSEEK_API_KEY=your-deepseek-key-here

# Embedding API (required for RAG knowledge base)
EMBEDDING_API_KEY=your-embedding-api-key-here

# Optional: Model configuration file path (defaults to LLM_Config/models.txt)
# METRON_MODEL_CONFIG=/path/to/models.txt

# Optional: Working directories
# METRON_WORK_DIR=./data/collects
# METRON_ENV_MAPPING=./data/env_mapping
# METRON_DOC_SPECIFY_ROOT=

# Optional: Proxy settings
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=http://proxy:port
